# URL of your deployed Medusa backend (no trailing slash)
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://your-medusa-backend.example.com
# Medusa Admin → Settings → Publishable API Keys
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_...
# Shown on the Contact page and used for "Contact about order"
NEXT_PUBLIC_CONTACT_EMAIL=orders@cjpacificusa.com
NEXT_PUBLIC_CONTACT_PHONE=
